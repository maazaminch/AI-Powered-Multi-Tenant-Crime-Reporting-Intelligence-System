# Storage Provider (s3 or cloudinary)
STORAGE_PROVIDER=cloudinary

# Cloudinary - ONLY these two are required for uploads to work
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_UPLOAD_PRESET=your_preset_name

# To create upload preset:
# 1. Go to cloudinary.com → Settings → Upload
# 2. Click "Add upload preset"
# 3. Name it something (e.g., "crime_saas_uploads")
# 4. Set "Signing mode" to "Unsigned"
# 5. Save and use that name here

# AWS S3 (only needed if STORAGE_PROVIDER=s3)
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=ap-south-1
PROFILE_BUCKET=crime-saas-profiles
EVIDENCE_BUCKET=crime-saas-evidence

# Audit Logging Configuration
AUDIT_LOG_LEVEL=INFO
AUDIT_ENABLED=true
AUDIT_ASYNC=true
AUDIT_RETENTION_DAYS=90